// AppAssist.rc - dialog and version resources
#include "resource.h"
#include "afxres.h"
#include "winres.h"
#include "Version.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_APPASSIST_DIALOG DIALOGEX 0, 0, 440, 360
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "AppAssist - Log Root Cause Diagnostic Tool"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "1. Knowledge base: index the application's source code (once per version)",IDC_GROUP_KB,7,5,426,74
    LTEXT           "Source folder:",IDC_LABEL_SOURCE,14,21,62,8
    EDITTEXT        IDC_SOURCE_DIR,80,19,286,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...",IDC_BROWSE_SOURCE,370,19,56,14
    LTEXT           "Knowledge base:",IDC_LABEL_KB,14,39,62,8
    EDITTEXT        IDC_KB_PATH,80,37,286,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...",IDC_BROWSE_KB,370,37,56,14
    PUSHBUTTON      "Build knowledge base",IDC_BUILD_KB,80,56,96,16
    LTEXT           "No knowledge base loaded.",IDC_KB_INFO,182,60,244,8,SS_ENDELLIPSIS

    GROUPBOX        "2. Diagnose a log",IDC_GROUP_LOG,7,84,426,96
    LTEXT           "Log file:",IDC_LABEL_LOG,14,100,62,8
    EDITTEXT        IDC_LOG_PATH,80,98,286,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...",IDC_BROWSE_LOG,370,98,56,14
    // The three engine radio buttons must be consecutive: a radio group runs from the WS_GROUP button
    // to the next WS_GROUP control, and static text (LTEXT/RTEXT) has WS_GROUP by default.
    CONTROL         "GGUF model:",IDC_ENGINE_EMBEDDED,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,14,119,64,10
    CONTROL         "Local server:",IDC_ENGINE_HTTP,"Button",BS_AUTORADIOBUTTON,14,138,64,10
    CONTROL         "No AI: show the source code matches only",IDC_ENGINE_NONE,"Button",BS_AUTORADIOBUTTON,14,157,200,10
    EDITTEXT        IDC_MODEL_PATH,80,117,226,14,ES_AUTOHSCROLL | WS_GROUP
    PUSHBUTTON      "Browse...",IDC_BROWSE_MODEL,310,117,56,14
    PUSHBUTTON      "Models...",IDC_MODELS,370,117,56,14
    EDITTEXT        IDC_HTTP_URL,80,136,206,14,ES_AUTOHSCROLL
    RTEXT           "Model:",IDC_HTTP_MODEL_LABEL,290,138,26,8
    EDITTEXT        IDC_HTTP_MODEL,320,136,106,14,ES_AUTOHSCROLL

    DEFPUSHBUTTON   "Analyze log",IDC_ANALYZE,7,188,72,16
    PUSHBUTTON      "Cancel",IDC_CANCEL_TASK,83,188,56,16,WS_DISABLED
    PUSHBUTTON      "Copy report",IDC_COPY_REPORT,301,188,64,16
    PUSHBUTTON      "Save report...",IDC_SAVE_REPORT,369,188,64,16
    LTEXT           "Ready.",IDC_STATUS,7,210,426,8,SS_ENDELLIPSIS
    EDITTEXT        IDC_OUTPUT,7,222,426,132,ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
END

IDD_MODEL_ADVISOR DIALOGEX 0, 0, 480, 273
STYLE DS_SETFONT | DS_FIXEDSYS | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Model Advisor - choose and download a GGUF model"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "",IDC_MA_SYSTEM,7,7,466,8,SS_ENDELLIPSIS
    LTEXT           "",IDC_MA_KB,7,18,466,8,SS_ENDELLIPSIS
    CONTROL         "",IDC_MA_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,7,30,466,66
    EDITTEXT        IDC_MA_ADVICE,7,101,466,92,ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT           "Download folder:",IDC_MA_DIR_LABEL,7,202,58,8
    EDITTEXT        IDC_MA_DIR,68,200,345,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...",IDC_MA_BROWSE,417,200,56,14
    CONTROL         "",IDC_MA_PROGRESS,"msctls_progress32",WS_BORDER,7,219,466,10
    LTEXT           "",IDC_MA_STATUS,7,233,466,8,SS_ENDELLIPSIS
    PUSHBUTTON      "Download",IDC_MA_DOWNLOAD,7,250,76,16
    PUSHBUTTON      "Cancel download",IDC_MA_CANCEL,87,250,76,16,WS_DISABLED
    DEFPUSHBUTTON   "Use this model",IDC_MA_USE,341,250,68,16
    PUSHBUTTON      "Close",IDCANCEL,413,250,60,16
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APPASSIST_VERSION_MAJOR,APPASSIST_VERSION_MINOR,APPASSIST_VERSION_PATCH,APPASSIST_VERSION_BUILD
 PRODUCTVERSION APPASSIST_VERSION_MAJOR,APPASSIST_VERSION_MINOR,APPASSIST_VERSION_PATCH,APPASSIST_VERSION_BUILD
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "AppAssist - log root cause diagnostic tool"
            VALUE "FileVersion", APPASSIST_VERSION_FULL
            VALUE "InternalName", "AppAssist"
            VALUE "OriginalFilename", "AppAssist.exe"
            VALUE "ProductName", "AppAssist"
            VALUE "ProductVersion", APPASSIST_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
